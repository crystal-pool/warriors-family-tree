{
  "name": "warriors-family-tree-repo",
  "version": "0.1.4",
  "type": "module",
  "description": "An complete and up-to-date warriors family tree.",
  "repository": "https://github.com/crystal-pool/warriors-family-tree",
  "author": "CXuesong",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --verbose --topological-dev --parallel --interlaced run build",
    "dev": "yarn workspace warriors-family-tree run dev",
    "dev:embed": "yarn workspace wft-embed run dev",
    "lint": "eslint .",
    "deploy-prod": "gh-pages -d ./packages/app/dist",
    "deploy": "pause && gh-pages -d ./packages/app/dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "gh-pages": "^3.2.3",
    "sass": "^1.99.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
